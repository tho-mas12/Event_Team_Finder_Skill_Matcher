@model EventFinder.Models.AddEventViewModel
@{
    ViewData["Title"] = "New Events - Create Event & Programs";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-light rounded-pill px-3 py-2 fw-semibold text-secondary shadow-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Admin Dashboard
    </a>
</div>

<div class="gradient-banner mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="stat-icon-wrapper bg-white text-dark rounded-circle p-3 fs-2 shadow">
            <i class="bi bi-calendar-plus-fill text-primary"></i>
        </div>
        <div>
            <h2 class="gradient-banner-title mb-1">Create New Event & Programs</h2>
            <p class="mb-0 opacity-90">Add event details, rules, max participant limits, event dates, and registration deadlines.</p>
        </div>
    </div>
</div>

<form asp-action="CreateEvent" method="post">
    @Html.AntiForgeryToken()

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <h4 class="fw-bold text-dark mb-3"><i class="bi bi-info-circle-fill text-primary me-2"></i>1. Event Core Details</h4>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold">Event Name <span class="text-danger">*</span></label>
                <input type="text" asp-for="Name" class="form-control" placeholder="e.g. HackSprint 2026" required />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                <select asp-for="Category" class="form-select" required>
                    <option value="Technical">Technical</option>
                    <option value="Hackathon">Hackathon</option>
                    <option value="Cultural">Cultural</option>
                    <option value="Workshop">Workshop</option>
                    <option value="Sports">Sports</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Banner Color Theme</label>
                <select asp-for="BannerGradient" class="form-select">
                    <option value="gradient-indigo">Indigo Theme</option>
                    <option value="gradient-purple">Purple Theme</option>
                    <option value="gradient-pink">Pink Theme</option>
                    <option value="gradient-emerald">Emerald Theme</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Location / Venue</label>
                <input type="text" asp-for="Location" class="form-control" placeholder="e.g. Main Auditorium / Lab 3" />
            </div>
            <div class="col-md-12">
                <label class="form-label fw-semibold">Event Description <span class="text-danger">*</span></label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Provide a general overview of this grand event..." required></textarea>
            </div>
        </div>
    </div>

    <!-- Sub-Programs Builder Container -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="fw-bold text-dark mb-0"><i class="bi bi-list-task text-indigo me-2"></i>2. Event Programs & Rules</h4>
                <div class="small text-muted">Add rules, max participant limits, date and registration deadline per program</div>
            </div>
            <button type="button" id="add-program-btn" class="btn btn-outline-primary rounded-pill fw-semibold">
                <i class="bi bi-plus-lg me-1"></i> Add Another Program
            </button>
        </div>

        <div id="programs-container">
            @for (int i = 0; i < Model.Programs.Count; i++)
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4 program-item p-4 bg-light position-relative">
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3 remove-program-btn" aria-label="Close"></button>
                    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-card-heading me-2"></i>Program #@(i + 1)</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Program Name <span class="text-danger">*</span></label>
                            <input type="text" name="Programs[@i].ProgramName" value="@Model.Programs[i].ProgramName" class="form-control" placeholder="e.g. Speed Coding" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Max Participants <span class="text-danger">*</span></label>
                            <input type="number" name="Programs[@i].MaxParticipants" value="@Model.Programs[i].MaxParticipants" class="form-control" min="1" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Team Size <span class="text-danger">*</span></label>
                            <input type="number" name="Programs[@i].TeamSize" value="@Model.Programs[i].TeamSize" class="form-control" min="1" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Event Date & Time <span class="text-danger">*</span></label>
                            <input type="datetime-local" name="Programs[@i].EventDate" value="@Model.Programs[i].EventDate.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Registration Deadline Date & Time <span class="text-danger">*</span></label>
                            <input type="datetime-local" name="Programs[@i].Deadline" value="@Model.Programs[i].Deadline.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Program Description</label>
                            <input type="text" name="Programs[@i].Description" value="@Model.Programs[i].Description" class="form-control" placeholder="Brief summary of program" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Rules & Guidelines <span class="text-danger">*</span></label>
                            <textarea name="Programs[@i].Rules" class="form-control" rows="3" placeholder="1. Rule one&#10;2. Rule two" required>@Model.Programs[i].Rules</textarea>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-end gap-3 mb-5">
        <a asp-action="Index" class="btn btn-light border rounded-pill px-4">Cancel</a>
        <button type="submit" class="btn btn-gradient-success rounded-pill px-5 py-3 fw-bold fs-6 shadow">
            <i class="bi bi-check-circle-fill me-2"></i> Publish Event & Programs
        </button>
    </div>
</form>
