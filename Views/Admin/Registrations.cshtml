@model IEnumerable<EventFinder.Models.ParticipantRegistration>
@{
    ViewData["Title"] = "Registered Event List";
    var programs = ViewBag.Programs as List<EventFinder.Models.EventProgram> ?? new List<EventFinder.Models.EventProgram>();
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    int? selectedProgId = ViewBag.SelectedProgramId;
    string selectedDept = ViewBag.SelectedDepartment ?? "";
    string searchTerm = ViewBag.SearchTerm ?? "";
}

<div class="mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-dark"><i class="bi bi-person-lines-fill text-primary me-2"></i>Registered Event Roster</h2>
        <p class="text-muted mb-0">Manage registered student participants across all campus events.</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-dark rounded-pill">
            <i class="bi bi-printer-fill me-1"></i> Print Roster
        </button>
        <a asp-action="NewEvent" class="btn btn-gradient-primary shadow rounded-pill">
            <i class="bi bi-plus-lg me-1"></i> Add Event
        </a>
    </div>
</div>

<!-- Search & Filter Controls -->
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
    <form method="get" asp-action="Registrations" class="row g-3 align-items-center">
        <div class="col-md-4">
            <label class="form-label fw-semibold small text-muted">Filter by Event Program</label>
            <select name="programId" class="form-select">
                <option value="">All Event Programs</option>
                @foreach (var p in programs)
                {
                    <option value="@p.Id" selected="@(selectedProgId == p.Id)">@p.ProgramName (@p.Event?.Name)</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label fw-semibold small text-muted">Filter by Department</label>
            <select name="department" class="form-select">
                <option value="">All Departments</option>
                @foreach (var d in departments)
                {
                    <option value="@d" selected="@(selectedDept == d)">@d</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label fw-semibold small text-muted">Search Student</label>
            <input type="text" name="search" value="@searchTerm" class="form-control" placeholder="Name, Dept No, Mobile..." />
        </div>

        <div class="col-md-2 d-flex gap-2 align-self-end">
            <button type="submit" class="btn btn-gradient-primary w-100"><i class="bi bi-search"></i> Search</button>
            <a asp-action="Registrations" class="btn btn-light border"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- Registrations Roster Table -->
<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <span class="fw-bold text-dark"><i class="bi bi-people-fill text-indigo me-2"></i>Total Registrations: <strong>@Model.Count()</strong></span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox display-3 text-muted"></i>
            <h5 class="fw-bold text-secondary mt-3">No Registrations Found</h5>
            <p class="text-muted small">No student registrations match your filter parameters.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table custom-table align-middle">
                <thead>
                    <tr>
                        <th>Student Name</th>
                        <th>Dept No</th>
                        <th>Department</th>
                        <th>Event Program</th>
                        <th>Mobile</th>
                        <th>Email</th>
                        <th>Skills</th>
                        <th>Team Status</th>
                        <th>Registered Date</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reg in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@reg.StudentName</td>
                            <td><span class="badge bg-light text-dark border">@reg.DeptNo</span></td>
                            <td><span class="badge bg-indigo-subtle text-indigo fw-bold">@reg.Department</span></td>
                            <td><strong class="text-primary">@reg.EventProgram?.ProgramName</strong></td>
                            <td><a href="tel:@reg.MobileNumber" class="text-decoration-none text-dark"><i class="bi bi-telephone text-success me-1"></i>@reg.MobileNumber</a></td>
                            <td class="small text-muted">@reg.Email</td>
                            <td class="small">
                                @if (!string.IsNullOrEmpty(reg.Skills))
                                {
                                    <span class="badge bg-secondary-subtle text-dark">@reg.Skills</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (reg.LookingForTeam == "Yes")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Needs Team</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">Has Team / Indiv</span>
                                }
                            </td>
                            <td class="small text-muted">@reg.RegisteredAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <form asp-action="DeleteRegistration" asp-route-id="@reg.Id" method="post" onsubmit="return confirm('Are you sure you want to remove this registration?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-2" title="Delete Registration">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
